# Local development only. Generate your own URL-safe password before starting Compose.
POSTGRES_PASSWORD=
# Required for first startup with an empty database.
CARTALYTIX_BOOTSTRAP_PASSWORD=
FRONTEND_PORT=8080
TOKEN_KEY_PATH=./.secrets/lidl.key

# For existing HTTPS Nginx, set your public origin and secure cookies.
CARTALYTIX_ENVIRONMENT=development
CARTALYTIX_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
CARTALYTIX_COOKIE_SECURE=false

# Actual Nginx peer IP/CIDR seen by the API container, e.g. its bridge gateway.
# Nginx must overwrite X-Forwarded-For; trust only the specific proxy peer.
CARTALYTIX_TRUSTED_PROXY_HOSTS=[]

# Public origin of this instance; enables the MCP connector (empty = disabled).
CARTALYTIX_PUBLIC_URL=
